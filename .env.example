# Public frontend build settings. Copy to .env when needed, then rebuild.
# Every VITE_* value is visible to browser users. Never place secrets here.

# Canonical SEO base URL for the official FlareTools site.
# For self-hosting, replace it with your own workers.dev URL or custom domain.
# Also update public/sitemap.xml, public/robots.txt and index.html's WebSite JSON-LD url.
# This value does not rewrite those static files.
VITE_SITE_URL=https://tools.arcinks.com

# Optional public Turnstile site key, paired with the Worker's secret key.
# Add your hostname in Turnstile. Leave unset when captcha is not enabled.
# Backend TURNSTILE_SECRET_KEY belongs in .dev.vars locally / a Worker secret remotely.
# VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
