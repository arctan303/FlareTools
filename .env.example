# Frontend Environment Variables (.env.example)

# Cloudflare Turnstile Site Key (Optional)
# If you enable Turnstile captcha verification, place your site key here.
# Cloudflare dummy test site key (always passes):
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Canonical Site URL (Optional, defaults to window.location.origin)
# VITE_SITE_URL=https://your-domain.com
