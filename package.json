{
  "name": "flare-tools",
  "version": "1.0.0",
  "description": "A modern, privacy-first developer utility suite running locally in your browser with serverless cross-device sharing.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local --ip 127.0.0.1 --port 8787 --local-upstream 127.0.0.1:8787",
    "deploy": "npm run build && wrangler deploy",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/check",
    "db:local": "wrangler d1 execute flare-tools-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute flare-tools-db --remote --file=./schema.sql",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test",
    "test:worker": "node scripts/worker-smoke.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@tailwindcss/typography": "^0.5.20",
    "color-convert": "^3.1.3",
    "crypto-js": "^4.2.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.9",
    "framer-motion": "^12.40.0",
    "js-beautify": "^1.15.4",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.5",
    "papaparse": "^5.5.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.17.0",
    "sql-formatter": "^15.8.1",
    "uuid": "^14.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12",
    "wrangler": "^4.147.0"
  }
}
