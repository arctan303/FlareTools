# Local Cloudflare Worker settings. Copy to .dev.vars only when needed.
# The copied file is local only; it does not become production configuration.
# Production non-secret variables belong in wrangler.toml [vars].
# Set production secrets using: npx wrangler secret put TURNSTILE_SECRET_KEY

# Optional Turnstile backend secret, paired with VITE_TURNSTILE_SITE_KEY.
# Leave unset to skip captcha. The 20 rooms / IP / UTC day cap still applies.
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Captcha defaults to enabled when the secret is set; false disables only captcha.
# ENABLE_TURNSTILE=true

# Optional exact additional origin accepted by TEXT SHARING only.
# Default is same origin. Do not use '*'; this is not a global CORS setting.
# The built-in Vite proxy already rewrites the local HTTP/WebSocket Origin.
# ALLOWED_ORIGIN=https://your-other-trusted-origin.com

# Optional additional trusted public HTTP diagnostics hosts.
# Comma-separated exact hostnames; no URLs or wildcards. Defaults remain allowed.
# NETWORK_ALLOWED_HOSTS=your-domain.com,status.your-domain.com

# ASSETS, DB, TEXT_ROOMS, TEXT_QUOTAS are bindings in wrangler.toml, not strings here.
