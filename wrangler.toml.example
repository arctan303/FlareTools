name = "flaretools"
main = "worker/index.js"
compatibility_date = "2026-10-04"
workers_dev = true
# Optional: bind a domain in your Cloudflare account.
# routes = [{ pattern = "tools.example.com", custom_domain = true }]

[assets]
directory = "./dist"
binding = "ASSETS"
not_found_handling = "single-page-application"
run_worker_first = ["/api", "/api/*"]

[[durable_objects.bindings]]
name = "TEXT_ROOMS"
class_name = "TextRoom"

[[durable_objects.bindings]]
name = "TEXT_QUOTAS"
class_name = "TextQuota"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["TextRoom", "TextQuota"]

[triggers]
crons = ["*/15 * * * *"]

# D1 stores temporary Mock APIs; text sharing uses Durable Objects.
# 1. Run: npx wrangler d1 create flare-tools-db
# 2. Copy the generated database_id to database_id below
# 3. Execute schema: npx wrangler d1 execute flare-tools-db --remote --file=./schema.sql

[[d1_databases]]
binding = "DB"
database_name = "flare-tools-db"
database_id = "YOUR_D1_DATABASE_ID"
